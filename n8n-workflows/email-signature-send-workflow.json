{
  "name": "RS Email Signature Send",
  "nodes": [
    {
      "parameters": {
        "content": "## RS Email Signature Send\n\nWebhook path: email-signature-send\n\nThis workflow receives `email_signature.send_requested` from RS_Tool-Email-Signature. Keep webhook auth and mail credentials in n8n. Add the production webhook URL to the app as EASYCOMMS_WEBHOOK_URL."
      },
      "id": "9f5539a0-7d54-4d79-91d4-3bf4c136c1d9",
      "name": "Setup Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -620,
        -260
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email-signature-send",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "97a983a9-17c5-4210-8b8b-9087b94f82c7",
      "name": "Email Signature Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst required = [\n  ['event', body.event],\n  ['recipient.email', body.recipient?.email],\n  ['recipient.name', body.recipient?.name],\n  ['signature.name', body.signature?.name],\n  ['signature.title', body.signature?.title],\n  ['signature.phone', body.signature?.phone],\n  ['signature.email', body.signature?.email],\n];\nconst missing = required.filter(([, value]) => !value).map(([key]) => key);\nif (body.event !== 'email_signature.send_requested') {\n  missing.push('event=email_signature.send_requested');\n}\nif (missing.length > 0) {\n  return [{ json: { ok: false, statusCode: 422, error: `Missing or invalid fields: ${missing.join(', ')}` } }];\n}\nreturn [{\n  json: {\n    ok: true,\n    statusCode: 200,\n    recipientEmail: body.recipient.email,\n    recipientName: body.recipient.name,\n    subject: `Romega email signature for ${body.signature.name}`,\n    html: body.signature.html,\n    text: body.signature.text,\n    fileName: body.signature.fileName,\n    imageDataUrl: body.assets?.imageDataUrl ?? null,\n    sourcePayload: body,\n  },\n}];"
      },
      "id": "47032a6e-b15d-48c0-bfdd-bfe69a32a86a",
      "name": "Validate Signature Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ]
    },
    {
      "parameters": {
