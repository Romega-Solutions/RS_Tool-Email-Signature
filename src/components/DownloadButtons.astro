---
---

<!-- Load html-to-image from CDN -->
<script src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.min.js"></script>

<div class="flex flex-col gap-3 w-full">
  <button
    class="flex min-h-11 items-center justify-center gap-2 rounded-lg bg-rs-primary-500 px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-rs-primary-600 focus:outline-none focus:ring-2 focus:ring-rs-primary-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
    id="download-btn"
    type="button"
  >
    <i data-lucide="image-down" class="h-5 w-5 flex-shrink-0 stroke-[2.25]"></i>
    Download as Image
  </button>

  <button
    class="flex min-h-11 items-center justify-center gap-2 rounded-lg bg-rs-accent-500 px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-rs-accent-600 focus:outline-none focus:ring-2 focus:ring-rs-accent-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
    id="send-email-btn"
    type="button"
  >
    <i data-lucide="send" class="h-5 w-5 flex-shrink-0 stroke-[2.25]"></i>
    Send to Email
  </button>
</div>

<!-- Success Dialog -->
<div id="email-success-dialog" class="fixed inset-0 bg-black bg-opacity-50 items-center justify-center z-50" style="display: none;">
  <div class="mx-4 max-w-md rounded-lg bg-white p-8 shadow-xl transition-all">
    <div class="text-center">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i data-lucide="circle-check-big" class="h-10 w-10 text-green-600 stroke-[2.25]"></i>
      </div>
      <h3 class="font-source-sans text-2xl font-bold text-rs-primary-700 mb-2">
        Email Sent Successfully!
      </h3>
      <p class="font-source-sans text-rs-neutral-600 mb-6">
        Your email signature has been sent to <strong id="sent-to-email" class="text-rs-primary-600"></strong>
      </p>
      <button
        id="close-dialog-btn"
        class="min-h-11 w-full rounded-lg bg-rs-primary-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-rs-primary-600 focus:outline-none focus:ring-2 focus:ring-rs-primary-500 focus:ring-offset-2"
      >
        Close
      </button>
    </div>
  </div>
</div>

<script>
  // Add type declarations for external libraries
  declare global {
    interface Window {
      htmlToImage?: {
        toPng: (node: HTMLElement, options?: any) => Promise<string>;
      };
      renderRomegaIcons?: () => boolean;
    }
  }

  function renderIcons() {
    window.renderRomegaIcons?.();
  }

  // Design canvas. The banner artwork is 1800x900 native, so 600x300 at
  // pixelRatio 3 exports exactly 1:1 with the source art — no resampling.
  const CARD_W = 600;
  const CARD_H = 300;
  const EXPORT_SCALE = 3;

  // html-to-image rasterizes whatever is on screen right now. If a webfont or
  // the banner bitmap hasn't finished, the export silently falls back to a
  // system font or a blank panel, with no error. Gate on both.
  async function waitForSignatureReady(node: HTMLElement) {
    if (document.fonts) {
      try {
        await document.fonts.ready;
        await Promise.all([
          document.fonts.load('25px "The Seasons"', 'Ag'),
          document.fonts.load('400 9px "Poppins"', 'Ag'),
          document.fonts.load('300 12px "Poppins"', 'Ag')
        ]);
      } catch {
        // Fall through: a fallback font beats blocking the download.
      }
    }

    // `complete` can be true while the bitmap is still decoding off-thread —
    // that is exactly how a blank banner ends up in the PNG. decode() is the
    // real gate.
    const images = Array.from(node.querySelectorAll('img'));
    await Promise.all(
      images.map((img) =>
        img.complete && img.naturalWidth > 0
          ? (img.decode ? img.decode().catch(() => undefined) : Promise.resolve())
          : new Promise((resolve) => {
              img.addEventListener('load', () => resolve(null), { once: true });
              img.addEventListener('error', () => resolve(null), { once: true });
            })
      )
    );

    // Re-fit now that real font metrics are available.
    (window as any).fitSignatureText?.();

    // Let layout settle before rasterizing.
    await new Promise(requestAnimationFrame);
  }

  // Function to generate the signature image
  async function generateSignatureImage(button: HTMLButtonElement): Promise<string | null> {
    const node = document.getElementById('signature-card') as HTMLElement | null;
    
    if (!node || !window.htmlToImage) {
      alert('Error: Unable to capture signature. Please try again.');
      return null;
    }

    // Show loading state
    const originalHtml = button.innerHTML;
    button.innerHTML = '<i data-lucide="loader-circle" class="h-5 w-5 flex-shrink-0 animate-spin stroke-[2.25]"></i> Generating...';
    button.disabled = true;
    renderIcons();

    try {
      await waitForSignatureReady(node);

      const dataUrl = await window.htmlToImage.toPng(node, {
        pixelRatio: EXPORT_SCALE,
        width: CARD_W,
        height: CARD_H,
        // Banner is opaque and covers the whole box; this only shows if the
        // artwork fails to load, so degrade to the banner blue, not white.
        backgroundColor: '#226093',
        cacheBust: true
      });

      button.innerHTML = originalHtml;
      button.disabled = false;
      renderIcons();
      
      return dataUrl;
    } catch (error) {
      console.error('Image generation failed:', error);
      alert('Image generation failed. Please try again.');
      button.innerHTML = originalHtml;
      button.disabled = false;
      renderIcons();
      return null;
    }
  }

  function getSignatureField(fieldName: string): string {
    const element = document.querySelector(`[data-field="${fieldName}"]`) as HTMLElement | null;
    return element?.textContent?.trim() || "";
  }

  function getSignaturePayload(imageDataUrl?: string) {
    return {
      name: getSignatureField('name'),
      title: getSignatureField('title'),
      phone: getSignatureField('phone'),
      email: getSignatureField('email'),
      imageDataUrl,
      source: 'email-signature-ui'
    };
  }

  function downloadImage(dataUrl: string, fileName: string) {
    const link = document.createElement('a');
    link.download = fileName;
    link.href = dataUrl;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  function makeFileName(userName: string) {
    const sanitizedName = userName.toLowerCase().replace(/\s+/g, '_').replace(/[^a-z0-9_]/g, '') || 'user';
    return `${sanitizedName}_email_signature.png`;
  }

  document.addEventListener('DOMContentLoaded', function() {
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement | null;
    const sendEmailBtn = document.getElementById('send-email-btn') as HTMLButtonElement | null;
    const emailDialog = document.getElementById('email-success-dialog') as HTMLElement | null;
    const closeDialogBtn = document.getElementById('close-dialog-btn') as HTMLButtonElement | null;
    const sentToEmailSpan = document.getElementById('sent-to-email') as HTMLElement | null;

    // Download Button Handler
    if (downloadBtn) {
      downloadBtn.addEventListener('click', async () => {
        const dataUrl = await generateSignatureImage(downloadBtn);
        
        if (!dataUrl) return;

        // Get the user's name for the filename
        const userName = getSignatureField('name') || 'user';
        downloadImage(dataUrl, makeFileName(userName));

        // Show success message
        downloadBtn.innerHTML = '<i data-lucide="circle-check" class="h-5 w-5 flex-shrink-0 stroke-[2.25]"></i> Downloaded';
        renderIcons();
        setTimeout(() => {
          downloadBtn.innerHTML = '<i data-lucide="image-down" class="h-5 w-5 flex-shrink-0 stroke-[2.25]"></i> Download as Image';
          renderIcons();
        }, 2000);
      });
    }

    // Send to Email Button Handler
    if (sendEmailBtn) {
      sendEmailBtn.addEventListener('click', async () => {
        const dataUrl = await generateSignatureImage(sendEmailBtn);
        
        if (!dataUrl) return;

        const payload = getSignaturePayload(dataUrl);

        try {
          const response = await fetch('/api/signature/send', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          const result = await response.json().catch(() => null);

          if (!response.ok || !result?.ok) {
            throw new Error(result?.error?.message || `Email automation failed with HTTP ${response.status}`);
          }

          sendEmailBtn.innerHTML = '<i data-lucide="circle-check" class="h-5 w-5 flex-shrink-0 stroke-[2.25]"></i> Sent';

          if (sentToEmailSpan) {
            sentToEmailSpan.textContent = payload.email || 'your email';
          }

          if (emailDialog) {
            emailDialog.style.display = 'flex';

            renderIcons();
          }
        } catch (error) {
          console.error('Email automation failed:', error);
          const userName = payload.name || 'user';
          downloadImage(dataUrl, makeFileName(userName));
          alert('Email automation is not available yet. The signature image was downloaded instead.');
        }

        // Reset button after a delay
        setTimeout(() => {
          sendEmailBtn.innerHTML = '<i data-lucide="send" class="h-5 w-5 flex-shrink-0 stroke-[2.25]"></i> Send to Email';
          renderIcons();
        }, 2000);
      });
    }

    // Close Dialog Handler
    if (closeDialogBtn && emailDialog) {
      closeDialogBtn.addEventListener('click', () => {
        emailDialog.style.display = 'none';
      });

      // Close dialog when clicking outside
      emailDialog.addEventListener('click', (e) => {
        if (e.target === emailDialog) {
          emailDialog.style.display = 'none';
        }
      });
    }
  });
</script>
