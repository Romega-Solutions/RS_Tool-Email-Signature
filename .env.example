# API key for headless RS Tools, EasyComms, and n8n callers.
# Send it as: X-API-Key: <value>
EMAIL_SIGNATURE_API_KEY=replace-with-generated-api-key

# Optional shared RS Tools key. The API accepts this as a fallback to align with Org Chart.
API_KEY=
RS_TOOLS_API_KEY=

# Server-side EasyComms/n8n webhook target. Do not expose this with PUBLIC_.
EASYCOMMS_WEBHOOK_URL=https://n8n.example.com/webhook/email-signature
EASYCOMMS_WEBHOOK_TOKEN=
EASYCOMMS_WEBHOOK_TIMEOUT_MS=10000
EMAIL_SIGNATURE_WEBHOOK_TIMEOUT_MS=10000

# Backward-compatible names if the automation is not yet branded as EasyComms.
EMAIL_SIGNATURE_WEBHOOK_URL=
EMAIL_SIGNATURE_WEBHOOK_TOKEN=

# Public UI send requests are restricted to these recipient domains.
# Leave comma-separated. API-key callers may bypass this public UI restriction.
EMAIL_SIGNATURE_ALLOWED_DOMAINS=romega-solutions.com

# Optional base URL used by external docs/scripts.
PUBLIC_EMAIL_SIGNATURE_BASE_URL=http://localhost:4321
